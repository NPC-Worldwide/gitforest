{
  "name": "gitforest-desktop",
  "version": "0.3.0",
  "description": "GitForest Desktop - P2P git hosting client",
  "author": "GitForest",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://gitforest.net",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && npm run build:preload && concurrently \"vite\" \"electron . --dev\"",
    "build": "npm run build:renderer && npm run build:electron && npm run build:preload && electron-builder",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:preload": "tsc -p tsconfig.preload.json && node -e \"const fs=require('fs');const s=fs.readFileSync('dist-electron/preload.js','utf8');if(/^(import|export)[\\s{*]/m.test(s)){console.error('ESM syntax in preload output');process.exit(1)}fs.renameSync('dist-electron/preload.js','dist-electron/preload.cjs')\"",
    "preview": "vite preview",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.471.1",
    "npcts": "^0.1.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.2.1"
  },
  "build": {
    "appId": "com.npcworldwide.gitforest",
    "productName": "GitForest",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../target/release/gitforest",
        "to": "bin/gitforest",
        "filter": ["**/*"]
      },
      {
        "from": "../target/release/git-remote-gitforest",
        "to": "bin/git-remote-gitforest",
        "filter": ["**/*"]
      },
      {
        "from": "../target/release/gtfo",
        "to": "bin/gtfo",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "icon": "gitforest.png",
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "icon": "gitforest.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "gitforest.png",
      "maintainer": "GitForest <info@npcworldwi.de>",
      "target": ["deb", "AppImage"],
      "executableName": "gitforest-desktop"
    },
    "deb": {
      "afterInstall": "build/after-install.sh",
      "afterRemove": "build/after-remove.sh"
    }
  }
}
